# Copy to .env for local development (`make api` reads it). Everything has a working
# development default, so this file is optional.

# Emails that get cloud sync at registration (R-CLOUD-8) and may use the web app
# (R-WEB-ACCESS). Register with one of these to use the web app locally. Any address
# works: every email is caught by Mailpit at http://localhost:58025.
CLOUD_SYNC_ALLOWLIST=owner@example.com

# Development defaults (shown for reference):
# APP_ENV=development
# PORT=8088
# DATABASE_URL=postgres://songsleeve:songsleeve@localhost:55432/songsleeve?sslmode=disable
# WEB_BASE_URL=http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# S3_ENDPOINT=http://localhost:58333
# S3_BUCKET=song-sleeve
# SMTP_ADDR=localhost:51025
# TERMS_VERSION=2026-10-draft
# STALL_TIMEOUT=5m
# MIN_CLIENT_VERSION_WEB=0.1.0
# TRUSTED_PROXIES=          # CIDRs whose X-Forwarded-For is trusted (set in production)

# Required outside development (never commit real values):
# SESSION_SECRET=
# DATA_KEY=
# RESEND_API_KEY=
